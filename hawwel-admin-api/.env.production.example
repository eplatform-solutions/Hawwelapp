NODE_ENV=production
PORT=5300

DB_URL=mongodb://127.0.0.1:27017/hawwel_client?replicaSet=rs0
DASH_DB_URL=mongodb://127.0.0.1:27017/hawwel_dashboard?replicaSet=rs0

BASE_API_URL=https://admin-api.7awalaty.com
BASE_ADMIN_API_URL=https://admin-api.7awalaty.com
WEBSITE_URL=https://admin.7awalaty.com

CORS_ALLOWED_ORIGINS=https://admin.7awalaty.com,https://api.7awalaty.com,https://admin-api.7awalaty.com

CLIENT_API_ASSETS_ROOT=/opt/hawwel/dasco-backend

JWT_SECRET_KEY=CHANGE_ME
SECRET_KEY=CHANGE_ME
# Encrypts blockchain wallet private keys. Must be identical in hawwel-api and differ from SECRET_KEY.
WALLET_ENCRYPTION_KEY=CHANGE_ME
# Only read by the network-fee-funding seeder on first setup; never commit a real value.
NETWORK_FEE_FUNDING_PRIVATE_KEY=
