NODE_ENV=production
PORT=5200

DB_URL=mongodb://127.0.0.1:27017/hawwel_client?replicaSet=rs0
DASH_DB_URL=mongodb://127.0.0.1:27017/hawwel_dashboard?replicaSet=rs0

BASE_API_URL=https://api.7awalaty.com
BASE_ADMIN_API_URL=https://admin-api.7awalaty.com
WEBSITE_URL=https://7awalaty.com

CORS_ALLOWED_ORIGINS=https://admin.7awalaty.com,https://api.7awalaty.com,https://admin-api.7awalaty.com

JWT_SECRET_KEY=CHANGE_ME
SECRET_KEY=CHANGE_ME
# Encrypts blockchain wallet private keys. Must be identical in dasco-backend-dashboard and differ from SECRET_KEY.
WALLET_ENCRYPTION_KEY=CHANGE_ME

# --- Compliance: sanctions/PEP screening ---
# Leave COMPLIANCE_SCREENING_ENABLED=false until scripts/check-screening.js
# passes. The transfer gate fails closed, so enabling it against an
# unreachable provider blocks every transfer.
COMPLIANCE_SCREENING_ENABLED=false
COMPLIANCE_SCREENING_BASE_URL=
COMPLIANCE_SCREENING_DATASET=
COMPLIANCE_SCREENING_API_KEY=
COMPLIANCE_SCREENING_FAIL_OPEN=false
COMPLIANCE_SCREENING_BLOCK_SCORE=
COMPLIANCE_SCREENING_REVIEW_SCORE=
COMPLIANCE_SCREENING_CACHE_TTL_MINUTES=
COMPLIANCE_SCREENING_TIMEOUT_MS=

# --- Compliance: cumulative limits (amounts in USDT/USDC) ---
COMPLIANCE_LIMIT_DAILY_AMOUNT=
COMPLIANCE_LIMIT_MONTHLY_AMOUNT=
COMPLIANCE_LIMIT_DAILY_COUNT=
COMPLIANCE_LIMIT_MONTHLY_DISTINCT_RECEIVERS=
COMPLIANCE_EDD_AMOUNT_THRESHOLD=
