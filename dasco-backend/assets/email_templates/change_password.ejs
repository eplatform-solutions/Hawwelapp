<%
    const isAr = language !== "en";
    const brand = isAr ? "حوّل" : "Hawwel";
    const logoUrl = process.env.EMAIL_LOGO_URL || "https://api.7awalaty.com/assets/images/email/logo.png";
    const supportEmail = process.env.SUPPORT_EMAIL || "support@hawwelapp.com";
    const t = isAr ? {
        title: "تم تغيير كلمة المرور",
        greeting: name ? `مرحباً ${name}،` : "مرحباً،",
        body: `تم تغيير كلمة المرور لحسابك في حوّل بتاريخ ${updatedAt}.`,
        ok: "إذا قمت بهذا التغيير بنفسك، فلا حاجة لأي إجراء.",
        notYou: "إذا لم تقم بهذا التغيير، غيّر كلمة المرور من التطبيق فوراً وتواصل معنا لتأمين حسابك.",
        help: "للمساعدة تواصل معنا على",
    } : {
        title: "Your password was changed",
        greeting: name ? `Hi ${name},` : "Hi,",
        body: `The password for your Hawwel account was changed on ${updatedAt}.`,
        ok: "If you made this change, no action is needed.",
        notYou: "If you did not make this change, reset your password in the app right away and contact us to secure your account.",
        help: "Need help? Contact us at",
    };
    const dir = isAr ? "rtl" : "ltr";
    const align = isAr ? "right" : "left";
%>
<!DOCTYPE html>
<html lang="<%= isAr ? 'ar' : 'en' %>" dir="<%= dir %>">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= t.title %></title>
</head>
<body style="margin:0; padding:0; background-color:#F7F6F1;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F7F6F1;">
        <tr>
            <td align="center" style="padding:24px 12px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px; background-color:#FFFFFF; border:1px solid #E5E2D6; border-radius:12px; overflow:hidden;">
                    <tr>
                        <td align="center" style="background-color:#0E2B2B; padding:24px;">
                            <img src="<%= logoUrl %>" width="72" height="87" alt="Hawwel" style="display:block; border:0; outline:none;">
                        </td>
                    </tr>
                    <tr>
                        <td dir="<%= dir %>" style="padding:32px 28px; font-family:Tahoma, Arial, sans-serif; color:#13201F; text-align:<%= align %>;">
                            <h1 style="margin:0 0 12px 0; font-size:22px; line-height:1.4; color:#0E2B2B;"><%= t.title %></h1>
                            <p style="margin:0 0 12px 0; font-size:16px; line-height:1.7;"><%= t.greeting %></p>
                            <p style="margin:0 0 12px 0; font-size:16px; line-height:1.7;"><%= t.body %></p>
                            <p style="margin:0 0 12px 0; font-size:16px; line-height:1.7;"><%= t.ok %></p>
                            <p style="margin:0; font-size:14px; line-height:1.7; font-weight:bold; color:#1F6F5B;"><%= t.notYou %></p>
                        </td>
                    </tr>
                    <tr>
                        <td dir="<%= dir %>" style="border-top:1px solid #E5E2D6; padding:16px 28px; font-family:Tahoma, Arial, sans-serif; font-size:12px; line-height:1.7; color:#66706D; text-align:center;">
                            <%= t.help %> <a href="mailto:<%= supportEmail %>" style="color:#1F6F5B; text-decoration:none;"><%= supportEmail %></a><br>
                            &copy; <%= new Date().getFullYear() %> <%= brand %>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
