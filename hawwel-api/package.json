{
  "name": "hawwel-server-side",
  "version": "1.0.0",
  "author": "Anas Adnan Derk",
  "license": "ISC",
  "description": "Hawwel platform backend API using Node.js, Expressjs, and MongoDB",
  "private": true,
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/anas-derk/hawwel-server-side"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node index",
    "seed:users": "node scripts/seed-users.js",
    "create:reviewer-user": "node scripts/create-reviewer-user.js",
    "migrate:account-deletion-request-indexes": "node scripts/migrate-account-deletion-request-indexes.js",
    "test:redis-fail-open": "node scripts/manual-test-redis-fail-open.js",
    "test:money-precision": "node scripts/manual-test-money-precision.js",
    "dev": "nodemon",
    "test": "cross-env NODE_ENV=test node index",
    "staging": "cross-env NODE_ENV=staging node index",
    "check:screening": "node scripts/check-screening.js",
    "test:reviewer-user": "node scripts/manual-test-reviewer-user.js",
    "test:send-currency": "node scripts/manual-test-send-currency.js",
    "test:travel-rule": "node scripts/manual-test-travel-rule.js",
    "test:reset-password": "node scripts/manual-test-reset-password.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "countries-list": "^3.2.2",
    "crypto-js": "^4.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "file-type": "^21.3.1",
    "firebase-admin": "^13.4.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.34",
    "mongoose": "^8.19.1",
    "multer": "^1.4.5-lts.1",
    "node-code-generator": "^1.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9",
    "nodemon": "^3.1.10",
    "rate-limiter-flexible": "^9.1.1",
    "sharp": "^0.34.4",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "web3": "^4.4.0"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.2.4"
  },
  "nodemonConfig": {
    "watch": [
      "*.*",
      ".env",
      "*"
    ],
    "ignore": [
      "node_modules",
      "assets/images"
    ],
    "ext": "*",
    "verbose": true,
    "env": {
      "NODE_ENV": "development"
    },
    "restartable": "rs"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^11.2.0"
  }
}
